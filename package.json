{
  "name": "velto-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:creator-smoke": "node scripts/creator-smoke-test.mjs",
    "fin:reconcile": "node --env-file=.env.local scripts/fin-p1c-reconcile.mjs",
    "test:fin-p1c": "node scripts/fin-p1c-smoke-test.mjs",
    "test:port-p1": "node scripts/port-p1-smoke-test.mjs",
    "test:port-p2": "node scripts/port-p2-smoke-test.mjs",
    "test:run-p1": "node scripts/run-p1-static-test.mjs",
    "test:run-p1:runtime": "node scripts/run-p1-smoke-test.mjs",
    "container:config": "docker compose --env-file .env.local config",
    "container:build": "docker compose --env-file .env.local build",
    "container:up": "docker compose --env-file .env.local up --build",
    "container:down": "docker compose down",
    "worker:scale": "node --env-file=.env.local scripts/scale-worker.mjs",
    "test:scale-p1:static": "node scripts/scale-p1-static-test.mjs",
    "test:scale-p1": "node --env-file=.env.local scripts/scale-p1-smoke-test.mjs",
    "test:scale-p1:multi": "node --env-file=.env.local scripts/scale-p1-multi-worker-test.mjs",
    "test:obs-p1": "node scripts/obs-p1-smoke-test.mjs",
    "test:voice-p1-3m": "node scripts/voice-p1-3m-smoke-test.mjs",
    "test:voice-p1b": "node scripts/voice-p1b-smoke-test.mjs",
    "test:voice-p1c": "node scripts/voice-p1c-smoke-test.mjs"
  },
  "dependencies": {
    "@runwayml/sdk": "^3.20.0",
    "@supabase/supabase-js": "^2.103.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "next": "16.2.3",
    "openai": "^6.39.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
