# syntax=docker/dockerfile:1.7
# Railway Worker packaging for the Stage 2 durable CreatorLab queue.
# The repository's default Dockerfile targets the Next.js runner.
# Railway does not select a named multistage Dockerfile target, so give
# the worker its own Dockerfile with the same runtime files as the existing
# "worker" stage of the repository Dockerfile.
FROM node:22-bookworm-slim

WORKDIR /app
ENV NODE_ENV=production \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY scripts/validate-runtime-env.mjs ./scripts/validate-runtime-env.mjs
COPY scripts/scale-worker.mjs ./scripts/scale-worker.mjs
COPY lib/runtime/coreEnvironment.mjs ./lib/runtime/coreEnvironment.mjs
COPY lib/worker ./lib/worker

USER node
STOPSIGNAL SIGTERM

CMD ["sh", "-c", "node scripts/validate-runtime-env.mjs worker && exec node scripts/scale-worker.mjs"]
