# Required browser/public Supabase configuration. These values are embedded
# into the client bundle during the Docker build; never put server secrets here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Required server-only configuration. SUPABASE_URL and SUPABASE_ANON_KEY are
# canonical on the server. The NEXT_PUBLIC_* values above remain supported as
# compatibility fallbacks, but SUPABASE_SERVICE_ROLE_KEY has no public alias.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
VELTO_DATABASE_DRIVER=supabase
VELTO_STORAGE_DRIVER=supabase

# Required web runtime configuration. Model overrides are optional and retain
# their built-in defaults when blank.
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=
OPENAI_CREATOR_DIRECTOR_MODEL=

# Optional Runway provider. RUNWAY_API_KEY is canonical. The two RUNWAYML_*
# names are compatibility aliases; normally configure only one. Resolution is
# RUNWAY_API_KEY, then RUNWAYML_API_SECRET, then RUNWAYML_API_KEY.
RUNWAY_API_KEY=
RUNWAYML_API_SECRET=
RUNWAYML_API_KEY=
RUNWAY_VIDEO_MODEL=

# Optional Veo provider. VEO_API_KEY is canonical; GEMINI_API_KEY is a
# compatibility alias used only when VEO_API_KEY is blank.
VEO_API_KEY=
GEMINI_API_KEY=
VEO_VIDEO_MODEL=
VEO_VIDEO_RESOLUTION=

# Optional ElevenLabs provider. Role-specific voice IDs are canonical.
# ELEVENLABS_VOICE_ID remains the compatibility fallback for character voices.
ELEVENLABS_API_KEY=
ELEVENLABS_TR_NARRATOR_VOICE_ID=
ELEVENLABS_EN_NARRATOR_VOICE_ID=
ELEVENLABS_TR_CHARACTER_VOICE_ID=
ELEVENLABS_EN_CHARACTER_VOICE_ID=
ELEVENLABS_VOICE_ID=

# Optional Epidemic Sound provider. Acquisition remains fail-closed unless the
# separate feature flag is set to exactly true.
EPIDEMIC_SOUND_API_KEY=
CREATOR_PREMIUM_MUSIC_ACQUISITION_ENABLED=false

# Optional integrations.
YOUTUBE_API_KEY=

# Canonical server-side export service URL. NEXT_PUBLIC_EXPORT_API_URL is a
# compatibility fallback only; prefer EXPORT_API_URL for new deployments.
EXPORT_API_URL=
NEXT_PUBLIC_EXPORT_API_URL=

# Required internal export authentication. Configure the same secret on the
# web and export service. It is server-only and must never use NEXT_PUBLIC_*
# naming. Generate a real secret outside this example.
VELTO_INTERNAL_EXPORT_TOKEN=

# Required only when premium music acquisition/export is enabled. This names
# the private Supabase Storage bucket used by the current runtime.
CREATOR_PREMIUM_MUSIC_BUCKET=

CREATOR_BASE_URL=
CREATOR_ACCESS_TOKEN=

# Required worker-only authentication. The worker also requires SUPABASE_URL
# (or its NEXT_PUBLIC_* fallback) and SUPABASE_SERVICE_ROLE_KEY from above.
VELTO_INTERNAL_WORKER_TOKEN=replace-with-a-dedicated-internal-worker-token

# Cloud-neutral runtime identity. VELTO_RELEASE is canonical across cloud
# environments; platform-specific commit identifiers remain fallbacks.
NEXT_PUBLIC_APP_VERSION=local-container
VELTO_RELEASE=
VELTO_WORKER_ID=
VELTO_INTERNAL_BASE_URL=

# Optional worker tuning. Leave blank to use the canonical runtime defaults
# shown in comments; Compose forwards only values that are explicitly set.
# Default: 2000 ms (clamped to 250..30000).
VELTO_QUEUE_POLL_MS=2000
# Default: 60 seconds (clamped to 15..900).
VELTO_QUEUE_LEASE_SECONDS=60
# Default: max(5000, lease/3); clamped to the lease-safe range.
VELTO_QUEUE_HEARTBEAT_MS=
# Default: 15000 ms (clamped to 5000..60000).
VELTO_WORKER_HEARTBEAT_MS=15000
# Defaults: 5 and 300 seconds; retry max remains at least retry base.
VELTO_QUEUE_RETRY_BASE_SECONDS=5
VELTO_QUEUE_RETRY_MAX_SECONDS=300
# Default: 60000 ms (clamped to 10000..3600000).
VELTO_FIN_RECONCILE_INTERVAL_MS=60000
# Default: 200 (clamped to 1..1000).
VELTO_FIN_RECONCILE_BATCH_LIMIT=200
# Default: 10 minutes (clamped to 1..1440).
VELTO_FIN_STALE_JOB_MINUTES=10
# Stage 0.7C server-only bootstrap quota. Leave the byte limit empty until the
# product allowance is decided; hard enforcement remains off until Stage 0.7D.
VELTO_STORAGE_LIMIT_BYTES=
VELTO_STORAGE_QUOTA_ENFORCEMENT_ENABLED=false
VELTO_STORAGE_ADMISSION_TTL_MINUTES=60
# Stage 0.7D-1 manual purge remains disabled until migration/recovery smoke pass.
VELTO_TRASH_RETENTION_DAYS=30
VELTO_PERMANENT_MEDIA_DELETE_ENABLED=false
